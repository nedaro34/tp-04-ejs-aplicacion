<article>
    <p><span><%= mascota.especie %></span></p>
    <h1><%= mascota.nombre %></h1>
    <p>
        <span>Edad:</span>
        <%= mascota.edad %>
            <% if(mascota.edad> 1) {%> años<% } else { %> año <% }%>
    </p>
    <p><span>Estado:</span> <%= mascota.estado %></p>
    <p><span>Descripcion:</span> <%= mascota.descripcion %></p>
    <img src="/img/mascota.svg" alt="">
    <div>
        <a href="/mascotas">Volver al listado</a>
    </div>
</article>