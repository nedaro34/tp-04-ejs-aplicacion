<article>
    <div>
        <p><%= mascota.especie %></p>
        <h1><%= mascota.nombre %></h1>
        <p>Edad: <%= mascota.edad %></p>
        <p><%= mascota.descripcion %></p>
        <p>Estado: <%= mascota.estado %></p>
    </div>
    <div>
        <img src="<%= mascota.imagen%>" alt="">
    </div>
    <a href="/mascotas">Volver al listado</a>
</article>